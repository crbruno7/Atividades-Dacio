<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Conversor de Temperatura Real-Time</title>
    <style>
        body { font-family: sans-serif; display: flex; justify-content: center; padding: 50px; background-color: #f4f4f9; }
        .container { background: white; padding: 2rem; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .field { margin-bottom: 1rem; }
        label { display: block; margin-bottom: 0.5; font-weight: bold; }
        input { width: 200px; padding: 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 1rem; }
    </style>
</head>
<body>

<div class="container">
    <h2>Conversor Térmico</h2>
    
    <div class="field">
        <label for="celsius">Graus Celsius (°C)</label>
        <input type="number" id="celsius" placeholder="0.00" step="0.01">
    </div>

    <div class="field">
        <label for="fahrenheit">Graus Fahrenheit (°F)</label>
        <input type="number" id="fahrenheit" placeholder="32.00" step="0.01">
    </div>
</div>

<script>
    const inputCelsius = document.getElementById('celsius');
    const inputFahrenheit = document.getElementById('fahrenheit');

    // Listener para Celsius -> Fahrenheit
    inputCelsius.addEventListener('input', () => {
        const c = parseFloat(inputCelsius.value);
        if (!isNaN(c)) {
            const f = (c * 9/5) + 32;
            inputFahrenheit.value = f.toFixed(2);
        } else {
            inputFahrenheit.value = "";
        }
    });

    // Listener para Fahrenheit -> Celsius
    inputFahrenheit.addEventListener('input', () => {
        const f = parseFloat(inputFahrenheit.value);
        if (!isNaN(f)) {
            const c = (f - 32) * 5/9;
            inputCelsius.value = c.toFixed(2);
        } else {
            inputCelsius.value = "";
        }
    });
</script>

</body>
</html>