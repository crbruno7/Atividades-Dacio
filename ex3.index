<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Notas Acadêmicas</title>
    <style>
        :root {
            --azul: #2980b9;
            --verde: #27ae60;
            --vermelho: #c0392b;
            --fundo: #f4f7f6;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--fundo);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .container {
            background: white;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 400px;
        }

        h2 { text-align: center; color: #333; margin-bottom: 1.5rem; }

        .form-group { margin-bottom: 1rem; }

        label { display: block; margin-bottom: 5px; font-weight: bold; color: #555; }

        input {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 6px;
            box-sizing: border-box; /* Garante que o padding não quebre a largura */
        }

        button {
            width: 100%;
            padding: 12px;
            background-color: #34495e;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 1rem;
            transition: background 0.3s;
        }

        button:hover { background-color: #2c3e50; }

        #resultado {
            margin-top: 1.5rem;
            padding: 1rem;
            border-radius: 6px;
            text-align: center;
            display: none;
            font-weight: bold;
        }

        /* Classes de Status */
        .aprovado { background-color: #d1ecf1; color: var(--azul); border: 1px solid var(--azul); }
        .exame { background-color: #d4edda; color: var(--verde); border: 1px solid var(--verde); }
        .reprovado { background-color: #f8d7da; color: var(--vermelho); border: 1px solid var(--vermelho); }
    </style>
</head>
<body>

<div class="container">
    <h2>Cálculo de Média</h2>
    
    <div class="form-group">
        <label>Nome do Aluno</label>
        <input type="text" id="nome" placeholder="Ex: João Silva">
    </div>

    <div class="form-group">
        <label>Nota 1</label>
        <input type="number" id="n1" step="0.1" min="0" max="10">
    </div>

    <div class="form-group">
        <label>Nota 2</label>
        <input type="number" id="n2" step="0.1" min="0" max="10">
    </div>

    <div class="form-group">
        <label>Nota 3</label>
        <input type="number" id="n3" step="0.1" min="0" max="10">
    </div>

    <button onclick="calcular()">Calcular Situação</button>

    <div id="resultado"></div>
</div>

<script>
    function calcular() {
        const nome = document.getElementById('nome').value;
        const n1 = parseFloat(document.getElementById('n1').value);
        const n2 = parseFloat(document.getElementById('n2').value);
        const n3 = parseFloat(document.getElementById('n3').value);
        const resDiv = document.getElementById('resultado');

        if (!nome || isNaN(n1) || isNaN(n2) || isNaN(n3)) {
            alert("Por favor, preencha todos os campos corretamente.");
            return;
        }

        const media = (n1 + n2 + n3) / 3;
        let mensagem = `Aluno: ${nome}<br>Média: ${media.toFixed(1)}<br>`;
        let classe = "";

        if (media >= 7.0) {
            classe = "aprovado";
            mensagem += "SITUAÇÃO: APROVADO";
        } 
        else if (media >= 4.0) {
            const falta = 10 - media;
            classe = "exame";
            mensagem += `SITUAÇÃO: EXAME<br>Faltam ${falta.toFixed(1)} para a nota 10`;
        } 
        else {
            classe = "reprovado";
            mensagem += "SITUAÇÃO: REPROVADO";
        }

        resDiv.className = classe;
        resDiv.innerHTML = mensagem;
        resDiv.style.display = "block";
    }
</script>

</body>
</html>